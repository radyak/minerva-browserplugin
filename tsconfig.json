{
  // Strict TypeScript for the extension; the tests have their own, slightly
  // looser config (test/tsconfig.json). WXT's generated base config is strict.
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [".wxt/wxt.d.ts", "src/**/*.ts", "wxt.config.ts", "vitest.config.ts"]
}
