{
  "name": "minerva",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-browser WebExtension that assists with online auctions by making effective prices transparent.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/package.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "test:unit": "node --test \"test/*.test.mjs\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "typecheck": "tsc -p jsconfig.json",
    "clean": "rm -rf dist build",
    "dev:firefox": "web-ext run --source-dir dist/firefox",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted"
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "web-ext": "^10.6.0"
  }
}
