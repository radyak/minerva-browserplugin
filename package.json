{
  "name": "minerva",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-browser WebExtension that assists with online auctions by making effective prices transparent.",
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "build": "wxt build -b chrome && wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "dev": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "package": "wxt zip -b chrome && wxt zip -b firefox",
    "icons": "node scripts/make-icons.mjs",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "test:unit": "node --test \"test/*.test.mjs\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "typecheck": "wxt prepare && tsc -p jsconfig.json",
    "clean": "rm -rf dist .wxt",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted"
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}
