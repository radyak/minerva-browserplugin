{
  "name": "browser-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-browser extension that marks a configured element on a configured URL and offers a side panel UI.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/package.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "clean": "rm -rf dist build",
    "dev:firefox": "web-ext run --source-dir dist/firefox",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted"
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "web-ext": "^10.6.0"
  }
}
