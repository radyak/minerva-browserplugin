{
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "maxNodeModuleJsDepth": 0,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": [".wxt/wxt.d.ts", "src/**/*.js", "test/**/*.mjs", "scripts/**/*.mjs", "wxt.config.js"]
}
