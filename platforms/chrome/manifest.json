{
  "manifest_version": 3,
  "name": "Minerva - Online Auction Assistant",
  "version": "$VERSION",
  "description": "Assists with online auctions by making effective prices transparent",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "storage", "sidePanel"],
  "host_permissions": "$CONTENT_MATCHES",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Minerva - Online Auction Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": "$CONTENT_MATCHES",
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
