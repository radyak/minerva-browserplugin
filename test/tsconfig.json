{
  // The tests: TypeScript like src/, but not strict - fakes and fixtures are
  // deliberately loose (untyped parameters, null where src expects a value).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false,
    "types": ["node"]
  },
  "include": ["../.wxt/wxt.d.ts", "**/*.ts"]
}
